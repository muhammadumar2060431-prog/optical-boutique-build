# =============================================================
#  OPTIQUE — Environment Variables EXAMPLE FILE
#  ✅  Is file ko GitHub pe push kar sakte ho — koi secret nahi
#  ✅  Asli .env file banao is se copy karke apne values dalo
# =============================================================

# ──────────────────────────────────────────────
#  Supabase — Database & Auth
# ──────────────────────────────────────────────
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE

# ──────────────────────────────────────────────
#  Admin Panel — Default Login Email
#  (Set up user password in Supabase Dashboard -> Authentication -> Users)
# ──────────────────────────────────────────────
VITE_ADMIN_EMAIL=admin@yoursite.com

# ──────────────────────────────────────────────
#  Site Configuration (Canonical URLs, Sitemap & SEO)
# ──────────────────────────────────────────────
VITE_SITE_URL=https://www.nigah.store
# Server-only API configuration. Never prefix the service key with VITE_.
SITE_URL=https://www.nigah.store
ALLOWED_ORIGINS=https://www.nigah.store,https://nigah.store
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE

# Development-only fallback login. Never configure these in production.
VITE_DEV_ADMIN_EMAIL=
VITE_DEV_ADMIN_PASSWORD=

# Server-side maintenance scripts only. Never expose this as a VITE_ variable.
SUPABASE_SERVICE_ROLE_KEY=

# One-time admin signup and security-question verification (server-only).
# Use separate random values of at least 32 characters. Never prefix with VITE_.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_SETUP_SECRET=
ADMIN_SECURITY_PEPPER=
# Sentry error tracking. The DSN is safe to expose; the auth token is not.
VITE_SENTRY_DSN=
SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
SENTRY_ENVIRONMENT=development
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_TRACES_SAMPLE_RATE=0.1

# Build-time source map upload (server-only; configure in CI/hosting).
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Supabase Edge Function email delivery secrets (set with supabase secrets set).
RESEND_API_KEY=
RESEND_FROM_EMAIL="OPTIQUE <onboarding@resend.dev>"
ADMIN_EMAIL=admin@example.com
RESEND_WEBHOOK_SECRET=
# Meta Conversions API (server-only; never prefix these with VITE_)
META_PIXEL_ID=
META_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v21.0
# Set temporarily from Events Manager > Test Events; leave empty in production.
TEST_EVENT_CODE=
