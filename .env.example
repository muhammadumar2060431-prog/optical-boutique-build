# =============================================================
#  OPTIQUE — Environment Variables EXAMPLE FILE
#  ✅  Is file ko GitHub pe push kar sakte ho — koi secret nahi
#  ✅  Asli .env file banao is se copy karke apne values dalo
# =============================================================

# ──────────────────────────────────────────────
#  Supabase — Database & Auth
# ──────────────────────────────────────────────
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE

# ──────────────────────────────────────────────
#  Admin Panel — Default Login Credentials
# ──────────────────────────────────────────────
VITE_ADMIN_EMAIL=admin@yoursite.com
VITE_ADMIN_PASSWORD=change_me_to_strong_password
