# =============================================================
#  OPTIQUE — Environment Variables EXAMPLE FILE
#  ✅  Is file ko GitHub pe push kar sakte ho — koi secret nahi
#  ✅  Asli .env file banao is se copy karke apne values dalo
# =============================================================

# ──────────────────────────────────────────────
#  Supabase — Database & Auth
# ──────────────────────────────────────────────
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE

# ──────────────────────────────────────────────
#  Admin Panel — Default Login Email
#  (Set up user password in Supabase Dashboard -> Authentication -> Users)
# ──────────────────────────────────────────────
VITE_ADMIN_EMAIL=admin@yoursite.com

# ──────────────────────────────────────────────
#  Site Configuration (Canonical URLs, Sitemap & SEO)
# ──────────────────────────────────────────────
VITE_SITE_URL=https://yourdomain.com
